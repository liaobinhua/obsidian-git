{
  "name": "obsidian-git-reviewed",
  "version": "0.1.0",
  "private": true,
  "description": "A small Obsidian Git plugin with explicit review before commit and push.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/main.ts' --test-coverage-lines=80 --test tests/*.test.ts",
    "check": "bun run typecheck && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
